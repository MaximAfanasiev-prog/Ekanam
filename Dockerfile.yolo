# Reuse only Python dependencies from the audited team inference image.
# Final stage contains no model weights or dataset.
ARG YOLO_DEPENDENCY_IMAGE=falcon-reid-inference:integration-96b97299
FROM ${YOLO_DEPENDENCY_IMAGE} AS dependencies
FROM python:3.12.3-slim@sha256:afc139a0a640942491ec481ad8dda10f2c5b753f5c969393b12480155fe15a63
RUN apt-get update && apt-get install -y --no-install-recommends libgl1 libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*
COPY --from=dependencies /usr/local /usr/local
WORKDIR /workspace
ENV PYTHONPATH=/workspace/src PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 \
    OMP_NUM_THREADS=1 HOME=/tmp YOLO_OFFLINE=1 YOLO_CONFIG_DIR=/tmp MPLCONFIGDIR=/tmp
COPY requirements-api.lock ./
RUN python -m pip install --no-cache-dir -r requirements-api.lock
COPY src ./src
USER 1009:1009
ENTRYPOINT ["python", "-m", "uvicorn"]
CMD ["street_falcon_reid.api:create_app", "--factory", "--host", "0.0.0.0", "--port", "8080", "--workers", "1", "--no-access-log", "--no-proxy-headers"]
